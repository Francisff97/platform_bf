APP_NAME=BaseForge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blueprintlike
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=database

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# MAIL_SCHEME=n
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME} Mailer"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=EUR

PLATFORM_INFO_URL=
PLATFORM_INFO_TTL=3600


ADDONS_ENABLED=true
FF_TUTORIALS=false
FF_EMAIL_TEMPLATES=false
FF_DISCORD_INTEGRATION=true

# --- Feature flags remoti ---
FLAGS_BASE_URL=
FLAGS_INSTALLATION_SLUG=test                       # <-- il tuo slug
FLAGS_SLUG=test                       # <-- il tuo slug
FLAGS_SIGNING_SECRET=
FLAGS_TTL=300                          # cache in secondi (es. 60)
FEATURES_FORCE_LOCAL=false   # metti true per forzare

FEATURES_ADDONS=true
FEATURES_EMAIL_TEMPLATES=true
FEATURES_DISCORD_INTEGRATION=true
FEATURES_TUTORIALS=false
FEATURES_ANNOUNCEMENTS=false    

PLATFORM_PUBLIC_URL=

# --- DISCORD WEBHOOK (il bot invia qui) ---
DISCORD_WEBHOOK_SECRET=
DISCORD_INCOMING_ENABLED=true

DISCORD_GUILD_ID=
DISCORD_CHANNEL_ANNOUNCEMENTS=
